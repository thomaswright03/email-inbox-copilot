# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Enable the "Gmail API" on the project first, and add this scope on the
# OAuth consent screen: gmail.modify
# Use a separate OAuth client (and separate values for every secret below)
# per environment: development, preview, production.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth. Generate with `npx auth secret` (32+ random bytes). Also keys the
# encryption of cached inbox data in Postgres (lib/crypto.ts).
AUTH_SECRET=

# Only these Google accounts may sign in. Comma-separated addresses and/or
# @domains, e.g. "me@gmail.com,@mycompany.com". Required in production: with
# it empty, a production deployment lets nobody sign in. Outside production,
# empty = any verified Google account.
ALLOWED_EMAILS=

# Gemini API key for the AI summary and spam classification. It must belong
# to a billing-enabled Google Cloud project (Gemini *paid* tier): the free
# tier lets Google use submitted content to improve its products, which
# Gmail data must never be used for.
GEMINI_API_KEY=

# The id of that billing-enabled Google Cloud project. Setting it is the
# operator's attestation that GEMINI_API_KEY is on the paid tier; record the
# switch in docs/compliance-records.md. While it is empty, AI features are off
# and nothing is sent to Gemini: the app shows a rule-based summary and spam
# list instead (lib/rules.ts).
GEMINI_PAID_TIER_PROJECT=

# Postgres (optional). Powers the audit log, the shared encrypted response
# cache, shared rate-limit counters and per-user session revocation.
# DATABASE_URL must use the least-privilege app role (inbox_app), NOT the
# database owner; see SECURITY.md "Database setup". Required in production:
# the Gemini spend budget fails closed without it. Elsewhere those features
# fall back to per-instance memory or no-op.
DATABASE_URL=

# Audit-log retention in days (minimum 30).
# AUDIT_RETENTION_DAYS=90

# Owner connection, used only by `npm run db:migrate` from a trusted machine
# or a deploy step. Never set this in the app's runtime environment.
# MIGRATION_DATABASE_URL=
# APP_DB_ROLE=inbox_app

# Optional: Slack/Discord-compatible incoming webhook (https) for security
# alerts (rate limits crossed, SSRF/CSRF attempts, revoked-session replays,
# Gemini quota exhaustion).
ALERT_WEBHOOK_URL=

# Optional abuse/spend limits (defaults shown). Counters are shared across
# instances when DATABASE_URL is set. The AI budgets reset at 00:00 UTC; see
# docs/deployment.md "AI budget" for how the defaults are sized.
# RATE_LIMIT_INBOX_READS_PER_MINUTE=20
# RATE_LIMIT_ACTIONS_PER_MINUTE=30
# AI_CALLS_PER_USER_PER_DAY=500
# AI_CALLS_GLOBAL_PER_DAY=5000
