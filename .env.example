# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Enable the "Gmail API" on the project first, and add this scope on the
# OAuth consent screen: gmail.modify
# Use a separate OAuth client (and separate values for every secret below)
# per environment: development, preview, production.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth. Generate with `npx auth secret` (32+ random bytes). Also keys the
# encryption of cached inbox data in Postgres (lib/crypto.ts).
AUTH_SECRET=

# Optional but strongly recommended for a private deployment: only these
# Google accounts may sign in. Comma-separated addresses and/or @domains,
# e.g. "me@gmail.com,@mycompany.com". Empty = any verified Google account.
ALLOWED_EMAILS=

# Gemini API key (free tier) for summarization + spam classification
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres (optional). Powers the audit log, the shared encrypted response
# cache, shared rate-limit counters and per-user session revocation.
# DATABASE_URL must use the least-privilege app role (inbox_app), NOT the
# database owner; see SECURITY.md "Database setup". Without it, those
# features fall back to per-instance memory or no-op.
DATABASE_URL=

# Owner connection, used only by `npm run db:migrate` from a trusted machine
# or a deploy step. Never set this in the app's runtime environment.
# MIGRATION_DATABASE_URL=
# APP_DB_ROLE=inbox_app

# Optional: Slack/Discord-compatible incoming webhook (https) for security
# alerts (rate limits crossed, SSRF/CSRF attempts, revoked-session replays,
# Gemini quota exhaustion).
ALERT_WEBHOOK_URL=

# Optional abuse/spend limits (defaults shown). Counters are shared across
# instances when DATABASE_URL is set.
# RATE_LIMIT_INBOX_READS_PER_MINUTE=20
# RATE_LIMIT_ACTIONS_PER_MINUTE=30
# AI_CALLS_PER_USER_PER_DAY=60
# AI_CALLS_GLOBAL_PER_DAY=400
