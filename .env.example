# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Enable the "Gmail API" on the project first, and add these scopes on the
# OAuth consent screen: gmail.readonly, gmail.modify
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth
AUTH_SECRET=

# Gemini API key (free tier) for summarization + spam classification
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres connection string for the Delete/Unsubscribe/spam-classification
# audit log (lib/audit.ts). On Vercel: Storage tab -> Create Database ->
# search "Neon"/"Postgres" in the Marketplace -> Create. This injects
# DATABASE_URL automatically. Without it set, audit logging silently no-ops
# rather than breaking the app.
DATABASE_URL=
